# =====================================================================
# FRITZ!Box Homarr Widget - Configuration
# =====================================================================

# FRITZ!Box IP address or hostname (default: 192.168.178.1 or fritz.box)
ROUTER_IP=192.168.178.1

# TR-064 Port (49000 for HTTP, 49443 for HTTPS)
ROUTER_PORT=49000

# Connection Protocol ('http' or 'https')
ROUTER_PROTOCOL=http

# FRITZ!Box User Credentials
# IMPORTANT FOR FRITZ!OS 8.25+:
# 1. Create a dedicated user under: System -> FRITZ!Box Users (FRITZ!Box-Benutzer)
# 2. Grant permissions: "FRITZ!Box Settings" (FRITZ!Box-Einstellungen)
# 3. Enable TR-064 access under: Home Network -> Network -> Network Settings
#    -> Check "Allow access for applications" (Zugriff für Anwendungen zulassen)
ROUTER_USERNAME=your_fritzbox_username
ROUTER_PASSWORD=your_fritzbox_password

# Request timeout in seconds
ROUTER_TIMEOUT=4

# Widget Web Server Port (default: 5050 - avoids macOS AirPlay port 5000 conflict)
PORT=5050

# Optional: Set to 'true' to generate simulated traffic data for UI testing
MOCK_MODE=false
